# Copy to ~/.config/immich-video-faces.env and `chmod 600` it.
# This file holds secrets: it must never be committed.

# Immich server address (with or without /api at the end)
IMMICH_URL=http://your-immich-server:2283
# Immich > Account Settings > API Keys. See README for the permissions it needs.
IMMICH_API_KEY=change-me

# Telegram morning report (optional). Token from @BotFather, chat id of you or your group.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Videos scanned per night
MAX_VIDEOS=3
# Don't start a new video after this time (HH:MM). Leave empty for no limit.
STOP_AFTER=06:30

# --- frames checked on the Pi (nothing is uploaded for these)
# One frame every N seconds (a face recognised at 18.2s can be missed at 18.0s: keep it dense)
CANDIDATE_INTERVAL=0.5
# At most this many frames per video (long videos get a wider interval)
CANDIDATE_MAX=120
# Videos up to this length are read in one fast pass; longer ones by jumping to each frame
ONE_PASS_MAX_SECONDS=180
# auto = check frames for faces on the Pi with OpenCV (only frames with faces are uploaded)
# off  = upload FRAMES_PER_VIDEO frames without checking
FACE_FILTER=auto
# Faces smaller than this (pixels) are ignored
MIN_FACE_PX=20
# Pi detector confidence (0-1) needed to count a face
FACE_SCORE=0.9

# --- frames uploaded to Immich
# Max frames with faces uploaded per video (the best ones, spread over the video).
# ~250 KB each, deleted right after: about 8 MB written per video.
FRAMES_PER_VIDEO=30
# Longest side of uploaded frames; Immich analyses a 1440px preview anyway
FRAME_MAX_SIZE=1440
# Per-video album: "<prefix> <date time> <video name>", deleted when the video is done
ALBUM_PREFIX=Video faces
# Max seconds to wait for Immich's background face jobs per video. If Immich is still busy,
# the frames are kept and the next run collects the results.
FACE_WAIT_TIMEOUT=900
# A video that fails this many times is skipped (see --retry-failed)
MAX_ATTEMPTS=3

# --- debugging
# Save every checked frame (faces drawn on it) in a dated folder per video. Empty = off.
#DEBUG_DIR=~/immich-video-faces-debug
# Where the "already scanned" list is kept
#STATE_DB=~/.local/share/immich-video-faces/state.db
